    <string name="perm_title">Two quick permissions</string>
    <string name="perm_subtitle">So we can tell you when to get off.</string>
    <string name="perm_location_title">Precise location</string>
    <string name="perm_location_body">To know which station you\'re at. Stations are less than 1 km apart, so approximate location isn\'t enough.</string>
    <string name="perm_notifications_title">Notifications</string>
    <string name="perm_notifications_body">To show your next stop and buzz before you need to get off.</string>
    <string name="perm_privacy_title">Only during a trip</string>
    <string name="perm_privacy_body">Location is used only while a trip is running and never leaves your phone.</string>
    <string name="perm_continue">Continue</string>
    <string name="perm_not_now">Not now</string>
    <string name="perm_precise_off_title">Precise location is off</string>
    <string name="perm_precise_off_body">Approximate location can be off by 1–3 km. Metro stations are closer together than that, so we can\'t tell which one you\'re at.</string>
    <string name="perm_denied_title">Location is off</string>
    <string name="perm_denied_body">The app needs your location during a trip to know which station you\'re at.</string>
    <string name="perm_settings_hint">In settings: Permissions → Location → Allow only while using the app, with Use precise location on</string>
